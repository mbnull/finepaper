    <bus name="opennoc_mesh_link" description="OpenNoC router-to-router mesh link.">
      <compatibility>
        <role name="initiator" connects_to="target" />
        <role name="target" connects_to="initiator" />
      </compatibility>
      <config>
      </config>
      <signals>
        <signal name="link" direction="inout" width="OPENNOC_MESH_LINK" />
      </signals>
    </bus>
    <bus name="opennoc_chi_attachment" description="OpenNoC CHI endpoint attachment.">
      <compatibility>
        <role name="initiator" connects_to="target" />
        <role name="target" connects_to="initiator" />
      </compatibility>
      <config>
      </config>
      <signals>
        <signal name="chi" direction="initiator_to_target" width="OPENNOC_CHI_ATTACHMENT" />
      </signals>
    </bus>
  </buses>
