      <interface id="north" label="North" bus="opennoc_mesh_link" role="target" connects_to="initiator" match="" cardinality="one" autocomplete_group="router_side" topology_rule="opposite_side">
      </interface>
      <interface id="south" label="South" bus="opennoc_mesh_link" role="initiator" connects_to="target" match="" cardinality="one" autocomplete_group="router_side" topology_rule="opposite_side">
      </interface>
      <interface id="p0" label="P0" bus="opennoc_chi_attachment" role="target" connects_to="initiator" match="" cardinality="one" autocomplete_group="endpoint_attachment">
      </interface>
      <interface id="p1" label="P1" bus="opennoc_chi_attachment" role="target" connects_to="initiator" match="" cardinality="one" autocomplete_group="endpoint_attachment">
      </interface>
    </interfaces>
    <ports>
      <port id="east" direction="inout" type="bus" bus_type="opennoc_mesh_link" role="router" name="East" description="East OpenNoC mesh link" interface="east" />
      <port id="west" direction="inout" type="bus" bus_type="opennoc_mesh_link" role="router" name="West" description="West OpenNoC mesh link" interface="west" />
      <port id="north" direction="inout" type="bus" bus_type="opennoc_mesh_link" role="router" name="North" description="North OpenNoC mesh link" interface="north" />
      <port id="south" direction="inout" type="bus" bus_type="opennoc_mesh_link" role="router" name="South" description="South OpenNoC mesh link" interface="south" />
      <port id="p0" direction="input" type="bus" bus_type="opennoc_chi_attachment" role="attachment" name="P0" description="OpenNoC CHI attachment slot 0" interface="p0" />
      <port id="p1" direction="input" type="bus" bus_type="opennoc_chi_attachment" role="attachment" name="P1" description="OpenNoC CHI attachment slot 1" interface="p1" />
    </ports>
    <parameters>
      <parameter name="display_name" type="string" default="OpenNoC XP" label="Display name" description="Name shown on the canvas." />
      <parameter name="external_id" type="string" default="xp_00" label="External ID" description="Stable generated artifact identifier." />
      <parameter name="x" type="int" default="0" description="Canvas X position." configurable="false" />
      <parameter name="y" type="int" default="0" description="Canvas Y position." configurable="false" />
      <parameter name="mesh_col" type="int" default="0" description="Logical OpenNoC mesh column." configurable="false" />
      <parameter name="mesh_row" type="int" default="0" description="Logical OpenNoC mesh row." configurable="false" />
    </parameters>
  </module>
