    <identity external_id_prefix="xp" display_prefix="XP" width="2" supports_mesh_coordinates="true" />
    <interfaces>
      <interface id="east" label="East" bus="opennoc_mesh_link" role="initiator" connects_to="target" match="" cardinality="one" autocomplete_group="router_side" topology_rule="opposite_side">
      </interface>
      <interface id="west" label="West" bus="opennoc_mesh_link" role="target" connects_to="initiator" match="" cardinality="one" autocomplete_group="router_side" topology_rule="opposite_side">
