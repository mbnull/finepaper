{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.fixture-catalog.v1",
  "title": "Ipcraft Gate 0 Fixture Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "ipcraft.fixture-catalog.v1" },
    "items": {
      "type": "array",
      "x-ipcraft-canonical": { "kind": "set", "sortKey": ["path"] },
      "$comment": "Entries are a canonical set sorted by path. Portable collision uniqueness, physical fixture totality, exact schema/phase/failureBoundary error-policy resolution, and behaviorEvidence case resolution are semantic authoring checks.",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schemaId", "validationPhase", "failureBoundary", "expected", "errorCode", "behaviorEvidence"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^fixtures/(?:valid|invalid)/[^/]+(?:/[^/]+)*\\.json$",
          "$comment": "The authoring verifier additionally enforces NFC, portable normalized path segments, Windows reserved-name/trailing-dot rules, and exact physical-file totality."
        },
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "ipcraft.fixture-catalog.v1" }
        },
        "validationPhase": { "enum": ["schema", "core-semantic"] },
        "failureBoundary": {
          "oneOf": [
            { "$ref": "#/$defs/failureBoundary" },
            { "type": "null" }
          ]
        },
        "expected": { "enum": ["accept", "reject"] },
        "errorCode": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "behaviorEvidence": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^vectors/[^/]+\\.json#[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "expected": { "const": "accept" } }, "required": ["expected"] },
          "then": {
            "properties": {
              "path": { "pattern": "^fixtures/valid/" },
              "failureBoundary": { "type": "null" },
              "errorCode": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "expected": { "const": "reject" } }, "required": ["expected"] },
          "then": {
            "properties": {
              "path": { "pattern": "^fixtures/invalid/" },
              "failureBoundary": { "$ref": "#/$defs/failureBoundary" },
              "errorCode": { "type": "string", "minLength": 1 },
              "behaviorEvidence": { "type": "null" }
            }
          }
        }
      ]
    },
    "failureBoundary": {
      "enum": [
        "authoritative-design-base", "bundle-manifest", "candidate-digest", "command-result",
        "contract-declaration", "derived-state-base", "diagnostic-report", "duplicate-id",
        "engine-bundle-binding", "engine-host-contract", "engine-migration-binding", "engine-platform",
        "entity-kind", "generic-structure", "host-side-effect-result", "legacy-project-root",
        "local-reference", "operation-shape", "output-manifest", "ownership", "package-declaration",
        "patch-envelope", "patch-invariant", "patched-subject-schema", "pending-group", "pipeline-result",
        "precondition", "project-duplicate-id", "project-invariant", "project-reference", "recovery-binding",
        "reference", "relation-kind", "request-generation", "runtime-result-binding", "session-revision",
        "source-authority", "structure-authority", "tool-artifact", "tool-input", "tool-result",
        "topology-input-base"
      ]
    }
  }
}
