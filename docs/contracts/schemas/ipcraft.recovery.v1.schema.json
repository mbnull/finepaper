{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.recovery.v1",
  "title": "Ipcraft Session Recovery V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "projectId", "savedProjectDigest", "updatedAt", "authoritativeDesign",
    "sessionRevision", "derivedStateRevision", "pendingTopologyGroup", "draftOverlay", "draftUndo", "draftRedo"
  ],
  "properties": {
    "schema": { "const": "ipcraft.recovery.v1" },
    "projectId": { "$ref": "#/$defs/id" },
    "savedProjectDigest": { "$ref": "#/$defs/digest" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "authoritativeDesign": { "$ref": "ipcraft.project-design.v1.schema.json" },
    "sessionRevision": { "type": "integer", "minimum": 0 },
    "derivedStateRevision": { "type": "integer", "minimum": 0 },
    "pendingTopologyGroup": { "oneOf": [{ "$ref": "#/$defs/pendingTopologyGroup" }, { "type": "null" }] },
    "draftOverlay": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/draftEntry" } },
    "draftUndo": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/draftOverlayMutation" } },
    "draftRedo": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/draftOverlayMutation" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "draftEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["draftId", "sequence", "commandType", "parameters", "validationStatus", "diagnostics"],
      "properties": {
        "draftId": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1 },
        "commandType": { "enum": ["CreateInterfaceFromTemplate", "RenameDesign", "RenameDomain", "RenameInterface"] },
        "parameters": { "type": "object" },
        "validationStatus": { "enum": ["unvalidated", "valid", "invalid"] },
        "diagnostics": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "ipcraft.command-result.v1.schema.json#/$defs/issue" } }
      },
      "allOf": [
        {
          "if": { "properties": { "commandType": { "const": "RenameDesign" } }, "required": ["commandType"] },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/renameDesignParameters" } } }
        },
        {
          "if": { "properties": { "commandType": { "const": "RenameInterface" } }, "required": ["commandType"] },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/renameInterfaceParameters" } } }
        },
        {
          "if": { "properties": { "commandType": { "const": "RenameDomain" } }, "required": ["commandType"] },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/renameDomainParameters" } } }
        },
        {
          "if": { "properties": { "commandType": { "const": "CreateInterfaceFromTemplate" } }, "required": ["commandType"] },
          "then": { "properties": { "parameters": { "$ref": "#/$defs/createInterfaceParameters" } } }
        }
      ]
    },
    "renameDesignParameters": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "renameInterfaceParameters": {
      "type": "object", "additionalProperties": false, "required": ["interfaceId", "name"],
      "properties": { "interfaceId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 } }
    },
    "renameDomainParameters": {
      "type": "object", "additionalProperties": false, "required": ["domainId", "name"],
      "properties": { "domainId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 } }
    },
    "createInterfaceParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["ownerComponentId", "templateKey", "name", "contract", "capabilities", "contractConfig", "nocConfig"],
      "properties": {
        "ownerComponentId": { "$ref": "#/$defs/id" }, "templateKey": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "contract": {
          "type": "object", "additionalProperties": false, "required": ["lockId", "role"],
          "properties": { "lockId": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/id" } }
        },
        "capabilities": { "type": "object" }, "contractConfig": { "type": "object" }, "nocConfig": { "type": "object" }
      }
    },
    "draftOverlayMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/draftEntry" } },
        "after": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/draftEntry" } }
      }
    },
    "topologyIntentMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": { "$ref": "ipcraft.core-canonical-models.v1.schema.json#/$defs/topologyIntent" },
        "after": { "$ref": "ipcraft.core-canonical-models.v1.schema.json#/$defs/topologyIntent" }
      }
    },
    "pendingTopologyGroup": {
      "type": "object", "additionalProperties": false,
      "required": [
        "groupId", "kind", "topologyInputRevision", "requestGeneration", "baseAuthoritativeDesignDigest",
        "baseDerivedStateRevision", "baseDerivedStateDigest", "topologyIntent", "intentUndo", "intentRedo",
        "normalizedTopologyInput", "topologyInputDigest", "status", "candidate"
      ],
      "properties": {
        "groupId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["topology-edit", "default-engine-migration"] },
        "topologyInputRevision": { "type": "integer", "minimum": 1 },
        "requestGeneration": { "type": "integer", "minimum": 1 },
        "baseAuthoritativeDesignDigest": { "$ref": "#/$defs/digest" },
        "baseDerivedStateRevision": { "type": "integer", "minimum": 0 },
        "baseDerivedStateDigest": { "$ref": "#/$defs/digest" },
        "topologyIntent": { "$ref": "ipcraft.core-canonical-models.v1.schema.json#/$defs/topologyIntent" },
        "intentUndo": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/topologyIntentMutation" } },
        "intentRedo": { "type": "array", "x-ipcraft-canonical": { "kind": "ordered" }, "items": { "$ref": "#/$defs/topologyIntentMutation" } },
        "normalizedTopologyInput": { "$ref": "ipcraft.core-canonical-models.v1.schema.json#/$defs/normalizedTopologyInput" },
        "topologyInputDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["drafting", "running", "candidate-validating", "ready-to-commit", "blocked", "failed"] },
        "candidate": { "type": "null" },
        "migration": { "$ref": "ipcraft.core-canonical-models.v1.schema.json#/$defs/migrationContext" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "default-engine-migration" } }, "required": ["kind"] },
          "then": { "required": ["migration"] },
          "else": { "not": { "required": ["migration"] } }
        }
      ]
    }
  }
}
