{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.engine-bundle.v1",
  "title": "Ipcraft Default Engine Bundle Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "engineHostContractVersion",
    "engineCompatibilityVersion",
    "hostSideEffectContractVersion",
    "migrationFromCompatibilityVersions",
    "supportedPlatformAbis",
    "entrypoint"
  ],
  "properties": {
    "schema": { "const": "ipcraft.engine-bundle.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "engineHostContractVersion": { "type": "string", "minLength": 1 },
    "engineCompatibilityVersion": { "type": "string", "minLength": 1 },
    "hostSideEffectContractVersion": { "type": "string", "minLength": 1 },
    "migrationFromCompatibilityVersions": {
      "type": "array",
      "x-ipcraft-canonical": { "kind": "set", "sortKey": ["unicodeScalarValue"] },
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supportedPlatformAbis": {
      "type": "array",
      "x-ipcraft-canonical": { "kind": "set", "sortKey": ["unicodeScalarValue"] },
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "entrypoint": {
      "type": "string",
      "$comment": "Semantic validation MUST enforce NFC, Windows reserved device names and trailing-dot/space rules, Unicode simple-case-fold collision detection, and exhaustive filesystem containment because JSON Schema regex cannot prove them.",
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F:])(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    }
  }
}
