{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.interface-contract.v1",
  "title": "Ipcraft Interface Contract Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "roles", "capabilities", "fields"],
  "properties": {
    "schema": { "const": "ipcraft.interface-contract.v1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/id" },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "default", "required", "editable"],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "type": { "enum": ["bool", "int", "double", "string", "enum"] },
        "default": { "$ref": "#/$defs/scalarOrNull" },
        "required": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "values": { "oneOf": [{ "type": "array", "items": { "$ref": "#/$defs/scalar" } }, { "type": "null" }] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "$ref": "#/$defs/id" },
        "equals": { "$ref": "#/$defs/scalar" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "type", "label", "description", "default", "required", "readOnly",
        "minimum", "maximum", "unit", "values", "visibleWhen", "enabledWhen"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "type": { "enum": ["bool", "int", "double", "string", "enum"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "default": { "$ref": "#/$defs/scalarOrNull" },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "minimum": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "maximum": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "unit": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "values": { "oneOf": [{ "type": "array", "items": { "$ref": "#/$defs/scalar" } }, { "type": "null" }] },
        "visibleWhen": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }] },
        "enabledWhen": { "oneOf": [{ "$ref": "#/$defs/condition" }, { "type": "null" }] }
      }
    },
    "scalar": { "type": ["boolean", "integer", "number", "string"] },
    "scalarOrNull": { "type": ["boolean", "integer", "number", "string", "null"] }
  }
}
