{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.artifact-manifest.v1",
  "title": "Ipcraft Artifact Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pipelineRunId", "stepId", "invocationId", "snapshotDigest", "artifacts"],
  "properties": {
    "schema": { "const": "ipcraft.artifact-manifest.v1" },
    "pipelineRunId": { "$ref": "#/$defs/id" },
    "stepId": { "$ref": "#/$defs/id" },
    "invocationId": { "$ref": "#/$defs/id" },
    "snapshotDigest": { "$ref": "#/$defs/digest" },
    "artifacts": {
      "type": "array",
      "x-ipcraft-canonical": { "kind": "set", "sortKey": ["path"] },
      "$comment": "Path uniqueness, portable-path collision checks, exhaustive membership, and sorting are semantic-validator rules.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mediaType", "size", "digest"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "kind": { "$ref": "#/$defs/id" },
          "mediaType": { "$ref": "#/$defs/id" },
          "size": { "type": "integer", "minimum": 0 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": {
      "type": "string",
      "$comment": "Semantic validation MUST enforce NFC, Windows reserved device names and trailing-dot/space rules, Unicode simple-case-fold collision detection, and exhaustive filesystem containment because JSON Schema regex cannot prove them.",
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F:])(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    }
  }
}
