{
  "schema": "ipcraft.fixture-error-policy.v1",
  "version": "1",
  "rulesSha256": "170504c680d673256a70be4d6a3a0f94646060d99f34c2a726b8a98f64b5d577",
  "rules": [
    { "schemaId": "ipcraft.artifact-manifest.v1", "validationPhase": "schema", "allowedErrorCodes": ["tool.artifact_invalid"] },
    { "schemaId": "ipcraft.artifact-manifest.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["tool.artifact_invalid"] },
    { "schemaId": "ipcraft.bundle-manifest.v1", "validationPhase": "schema", "allowedErrorCodes": ["dependency.manifest_invalid"] },
    { "schemaId": "ipcraft.bundle-manifest.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["dependency.manifest_invalid"] },
    { "schemaId": "ipcraft.command-result.v1", "validationPhase": "schema", "allowedErrorCodes": ["command.result_invalid"] },
    { "schemaId": "ipcraft.command-result.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["command.result_invalid"] },
    { "schemaId": "ipcraft.core-canonical-models.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.core-canonical-models.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["contract.schema_invalid", "engine.migration_invalid"] },
    { "schemaId": "ipcraft.diagnostic-report.v1", "validationPhase": "schema", "allowedErrorCodes": ["diagnostic.report_invalid"] },
    { "schemaId": "ipcraft.diagnostic-report.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["diagnostic.report_invalid"] },
    { "schemaId": "ipcraft.engine-bundle.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.engine-bundle.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["engine.bundle_mismatch", "engine.host_contract_unsupported", "engine.platform_unsupported"] },
    { "schemaId": "ipcraft.interface-contract.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.interface-contract.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["contract.invariant_violation"] },
    { "schemaId": "ipcraft.noc-package.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.noc-package.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["package.invariant_violation"] },
    { "schemaId": "ipcraft.noc-side-effects.v1", "validationPhase": "schema", "allowedErrorCodes": ["host.side_effect_result_invalid"] },
    { "schemaId": "ipcraft.noc-side-effects.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["host.side_effect_result_invalid"] },
    { "schemaId": "ipcraft.output-manifest.v1", "validationPhase": "schema", "allowedErrorCodes": ["output.manifest_invalid"] },
    { "schemaId": "ipcraft.output-manifest.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["output.manifest_invalid"] },
    { "schemaId": "ipcraft.patch.v1", "validationPhase": "schema", "allowedErrorCodes": ["patch.operation_invalid", "patch.schema_invalid"] },
    { "schemaId": "ipcraft.patch.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["patch.authoritative_design_base_conflict", "patch.authority_conflict", "patch.candidate_conflict", "patch.derived_state_base_conflict", "patch.duplicate_id", "patch.group_conflict", "patch.invariant_violation", "patch.local_ref_invalid", "patch.operation_invalid", "patch.ownership_violation", "patch.precondition_failed", "patch.request_generation_conflict", "patch.revision_conflict", "patch.schema_violation", "patch.source_not_allowed", "patch.topology_input_conflict", "patch.unknown_entity_kind", "patch.unknown_reference", "patch.unknown_relation_kind"] },
    { "schemaId": "ipcraft.pipeline-plan.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.pipeline-plan.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.pipeline-result.v1", "validationPhase": "schema", "allowedErrorCodes": ["pipeline.result_invalid"] },
    { "schemaId": "ipcraft.pipeline-result.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["pipeline.result_invalid"] },
    { "schemaId": "ipcraft.project-design.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid", "project.legacy_format_unsupported"] },
    { "schemaId": "ipcraft.project-design.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["project.duplicate_id", "project.invariant_violation", "project.unknown_reference"] },
    { "schemaId": "ipcraft.recovery.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.recovery.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["recovery.binding_mismatch"] },
    { "schemaId": "ipcraft.step-result.v1", "validationPhase": "schema", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.step-result.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["contract.schema_invalid"] },
    { "schemaId": "ipcraft.tool-input.v1", "validationPhase": "schema", "allowedErrorCodes": ["tool.input_invalid"] },
    { "schemaId": "ipcraft.tool-input.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["tool.input_invalid"] },
    { "schemaId": "ipcraft.tool-result.v1", "validationPhase": "schema", "allowedErrorCodes": ["tool.result_invalid"] },
    { "schemaId": "ipcraft.tool-result.v1", "validationPhase": "core-semantic", "allowedErrorCodes": ["tool.result_invalid", "tool.result_mismatch"] }
  ]
}
