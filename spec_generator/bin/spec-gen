#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'optparse'
require 'spec_generator'

options = {
  check: false,
  ipcore_path: nil,
  package_root: nil
}

begin
  known_commands = %w[check build]
  if ARGV.first && !ARGV.first.start_with?('-')
    raise SpecGenerator::SpecError, "unknown command: #{ARGV.first}" unless known_commands.include?(ARGV.first)

    command = ARGV.shift
  end

  OptionParser.new do |parser|
    parser.banner = 'Usage: spec-gen [check|build] [options]'
    parser.on('--check', 'Verify committed package manifests match specs') { options[:check] = true }
    parser.on('--ipcore PATH', 'IP core YAML path') { |value| options[:ipcore_path] = value }
    parser.on('--package-root DIR', 'Ipcraft package root') { |value| options[:package_root] = value }
  end.parse!

  raise SpecGenerator::SpecError, "unknown command: #{ARGV.first}" unless ARGV.empty?

  if command == 'check'
    raise SpecGenerator::SpecError, '--ipcore is required with check' unless options[:ipcore_path]

    SpecGenerator.check_ipcraft_package_source(
      ipcore_path: options[:ipcore_path],
      package_root: options[:package_root] || File.dirname(options[:ipcore_path])
    )
    puts "Checked ipcraft package source: #{options[:ipcore_path]}"
  elsif command == 'build'
    raise SpecGenerator::SpecError, '--ipcore is required with build' unless options[:ipcore_path]
    raise SpecGenerator::SpecError, '--package-root is required with build' unless options[:package_root]

    manifest_path = SpecGenerator.build_ipcraft_manifest(
      ipcore_path: options[:ipcore_path],
      package_root: options[:package_root]
    )
    puts "Built ipcraft manifest: #{manifest_path}"
  elsif options[:check]
    SpecGenerator.check_repository_ipcraft_manifests(root: Dir.pwd)
    puts 'Repository ipcraft manifests are up to date'
  elsif options[:ipcore_path]
    raise SpecGenerator::SpecError, 'command is required with --ipcore; use check or build'
  else
    SpecGenerator.build_repository_ipcraft_manifests(root: Dir.pwd)
    puts 'Generated repository ipcraft manifests'
  end
rescue SpecGenerator::SpecError => error
  warn "error: #{error.message}"
  exit 1
end
