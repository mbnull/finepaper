{
  "schema": "ipcraft.project.v1",
  "id": "composition_two_ip_project",
  "name": "Composition Two IP Project",
  "packages": [
    {
      "id": "vendor.example.composition_endpoint",
      "version": "1.0.0"
    }
  ],
  "components": [
    {
      "id": "producer",
      "type": "vendor.example.composition_endpoint",
      "packageRef": "vendor.example.composition_endpoint@1.0.0",
      "config": {}
    },
    {
      "id": "consumer",
      "type": "vendor.example.composition_endpoint",
      "packageRef": "vendor.example.composition_endpoint@1.0.0",
      "config": {}
    }
  ],
  "interfaces": [
    {
      "id": "m_axi",
      "ownerComponentId": "producer",
      "type": "bus",
      "role": "master",
      "direction": "out",
      "protocol": "axi4"
    },
    {
      "id": "s_axi",
      "ownerComponentId": "consumer",
      "type": "bus",
      "role": "slave",
      "direction": "in",
      "protocol": "axi4"
    }
  ],
  "connections": [
    {
      "id": "axi_link",
      "from": {
        "component": "producer",
        "interface": "m_axi"
      },
      "to": {
        "component": "consumer",
        "interface": "s_axi"
      },
      "kind": "interface"
    }
  ],
  "topologies": [],
  "views": [
    {
      "id": "main",
      "schema": "ipcraft.view.v1",
      "kind": "canvas",
      "targetRef": "project",
      "providerRef": "finepaper.editor",
      "layout": {
        "canvas": {
          "nodes": {
            "producer": {
              "x": 0,
              "y": 0
            },
            "consumer": {
              "x": 240,
              "y": 0
            }
          },
          "connections": {}
        }
      }
    }
  ],
  "diagnostics": [],
  "artifacts": [],
  "extensions": [],
  "metadata": {}
}
