{
  "schema": "ipcraft.project.v1",
  "project": {
    "id": "clock_fanout_project",
    "name": "Clock Fanout Project"
  },
  "instances": [
    {
      "id": "pll0",
      "package": {
        "id": "vendor.example.clocked",
        "version": "1.0.0"
      },
      "config": {}
    },
    {
      "id": "ip0",
      "package": {
        "id": "vendor.example.clocked",
        "version": "1.0.0"
      },
      "config": {}
    },
    {
      "id": "ip1",
      "package": {
        "id": "vendor.example.clocked",
        "version": "1.0.0"
      },
      "config": {}
    }
  ],
  "composition": {
    "connections": [
      {
        "id": "sys_clk",
        "type": "clock",
        "source": "user",
        "endpoints": [
          {
            "instance": "pll0",
            "interface": "clk_out",
            "role": "source"
          },
          {
            "instance": "ip0",
            "interface": "clk_in",
            "role": "sink"
          },
          {
            "instance": "ip1",
            "interface": "clk_in",
            "role": "sink"
          }
        ]
      }
    ],
    "external_ports": []
  },
  "layout": {},
  "diagnostics": {
    "schema": "ipcraft.diagnostics.v1",
    "records": []
  },
  "artifacts": {},
