module ravenoc_top (
  input logic clk_noc,
  input logic arst_noc
);
  import amba_axi_pkg::*;
  import ravenoc_pkg::*;

  logic [NoCSize-1:0] clk_axi;
  logic [NoCSize-1:0] arst_axi;
  s_axi_mosi_t [NoCSize-1:0] axi_mosi_if;
  s_axi_miso_t [NoCSize-1:0] axi_miso_if;
  s_irq_ni_t   [NoCSize-1:0] irqs;
  logic [NoCSize-1:0] bypass_cdc;

  assign clk_axi = {NoCSize{clk_noc}};
  assign arst_axi = {NoCSize{arst_noc}};
  assign bypass_cdc = {NoCSize{<%= bypass_cdc_literal %>}};

<% (0...noc_size).each do |slot| -%>
<% endpoint = endpoint_by_slot[slot] -%>
<% if endpoint -%>
  s_axi_mosi_t ep<%= slot %>_axi_mosi;

  ravenoc_endpoint_dummy #(
    .RAVENOC_SLOT(<%= endpoint.fetch('slot') %>)
  ) <%= endpoint.fetch('instance') %> (
    .clk_axi(clk_axi[<%= slot %>]),
    .arst_axi(arst_axi[<%= slot %>]),
    .axi_mosi(ep<%= slot %>_axi_mosi),
    .axi_miso(axi_miso_if[<%= slot %>]),
    .irq(irqs[<%= slot %>])
  );
  assign axi_mosi_if[<%= slot %>] = ep<%= slot %>_axi_mosi;

<% else -%>
  assign axi_mosi_if[<%= slot %>] = '0;

<% end -%>
<% end -%>
  ravenoc #(
    .AXI_CDC_REQ(<%= axi_cdc_literal %>)
  ) u_ravenoc (
    .clk_axi(clk_axi),
    .clk_noc(clk_noc),
    .arst_axi(arst_axi),
    .arst_noc(arst_noc),
    .axi_mosi_if(axi_mosi_if),
    .axi_miso_if(axi_miso_if),
    .irqs(irqs),
    .bypass_cdc(bypass_cdc)
  );
endmodule
