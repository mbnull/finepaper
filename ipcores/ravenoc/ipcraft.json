{
  "schema": "ipcraft.package.v1",
  "id": "finepaper.ravenoc",
  "name": "RaveNoC",
  "version": "1.0",
  "extensions": [
    "ipcraft.artifacts",
    "ipcraft.config.params",
    "ipcraft.emitters",
    "ipcraft.flows",
    "ipcraft.graph_config",
    "ipcraft.views",
    "noc.v1"
  ],
  "config_schema": {
    "parameters": [
      {
        "id": "flit_data_width",
        "type": "int",
        "default": 32,
        "range": {
          "min": 8,
          "max": 512
        },
        "label": "Flit data width",
        "description": "FLIT_DATA_WIDTH macro value."
      },
      {
        "id": "flit_type_width",
        "type": "int",
        "default": 2,
        "range": {
          "min": 1,
          "max": 8
        },
        "label": "Flit type width",
        "description": "FLIT_TP_WIDTH macro value."
      },
      {
        "id": "flit_buffer_depth",
        "type": "int",
        "default": 2,
        "range": {
          "min": 1,
          "max": 1024
        },
        "label": "Flit buffer depth",
        "description": "FLIT_BUFF macro value; must be a power of two."
      },
      {
        "id": "virtual_channels",
        "type": "int",
        "default": 3,
        "range": {
          "min": 1,
          "max": 16
        },
        "label": "Virtual channels",
        "description": "N_VIRT_CHN macro value."
      },
      {
        "id": "routing_algorithm",
        "type": "enum",
        "value_type": "string",
        "values": [
          "xy",
          "yx"
        ],
        "default": "xy",
        "label": "Routing algorithm",
        "description": "ROUTING_ALG macro value."
      },
      {
        "id": "priority",
        "type": "enum",
        "value_type": "string",
        "values": [
          "zero_high",
          "zero_low"
        ],
        "default": "zero_high",
        "label": "Priority",
        "description": "H_PRIORITY macro value."
      },
      {
        "id": "max_packet_flits",
        "type": "int",
        "default": 256,
        "range": {
          "min": 1,
          "max": 4096
        },
        "label": "Max packet flits",
        "description": "MAX_SZ_PKT macro value."
      },
      {
        "id": "axi_addr_width",
        "type": "int",
        "default": 32,
        "range": {
          "min": 8,
          "max": 64
        },
        "label": "AXI address width",
        "description": "AXI_ADDR_WIDTH macro value."
      },
      {
        "id": "axi_data_width",
        "type": "int",
        "default": 32,
        "range": {
          "min": 8,
          "max": 512
        },
        "label": "AXI data width",
        "description": "AXI_DATA_WIDTH macro value."
      },
      {
        "id": "axi_cdc_required",
        "type": "string",
        "default": "all",
        "label": "AXI CDC required",
        "description": "AXI_CDC_REQ policy: all, none, or bit mask."
      },
      {
        "id": "bypass_cdc",
        "type": "bool",
        "default": false,
        "label": "Bypass CDC in smoke",
        "description": "Drive generated bypass_cdc vector high in the smoke wrapper."
      }
    ]
  },
  "views": [
    {
      "module": "RaveTile",
      "file": "views/RaveTile.xml"
    },
    {
      "module": "RaveEndpoint",
      "file": "views/RaveEndpoint.xml"
    }
  ],
  "graph_config": {
    "schema": "ipcraft.graph-config.v1",
    "objects": [],
    "relationships": [],
    "properties": {},
    "native": {}
  },
  "emitters": [
    {
      "id": "graph_config",
      "kind": "emit_graph_config",
      "path": "graph_config.json"
    },
    {
      "id": "parameters",
      "kind": "emit_parameters",
      "path": "parameters.json"
    }
  ],
  "flows": [
    {
      "id": "generate",
      "label": "Generate",
      "scope": "instance",
      "steps": [
        {
          "kind": "emit_inputs"
        },
        {
          "kind": "exec",
          "command": {
            "framework_tool": "ipcraft-generate",
            "args": [
              "--manifest",
              "{package.manifest}",
              "--input",
              "{inputs.manifest}",
              "--output",
              "{out}"
            ],
            "cwd": "run_dir",
            "timeout_ms": 300000,
            "env": {
              "allow": []
            },
            "capture": {
              "stdout": "stdout.log",
              "stderr": "stderr.log",
              "max_bytes": 1048576
            }
          }
        },
        {
          "kind": "collect_artifacts"
        }
      ]
    },
    {
      "id": "validate",
      "label": "Validate",
      "scope": "instance",
      "steps": [
        {
          "kind": "emit_inputs"
        },
        {
          "kind": "exec",
          "command": {
            "framework_tool": "ipcraft-generate",
            "args": [
              "--manifest",
              "{package.manifest}",
              "--input",
              "{inputs.manifest}",
              "--validate"
            ],
            "cwd": "run_dir",
            "timeout_ms": 300000,
            "env": {
              "allow": []
            },
            "capture": {
              "stdout": "stdout.log",
              "stderr": "stderr.log",
              "max_bytes": 1048576
            }
          }
        }
      ]
    }
  ],
  "artifacts": [
    {
      "id": "config_header",
      "type": "resolved_config",
      "glob": "ravenoc_config.svh",
      "primary": true
    },
    {
      "id": "rtl",
      "type": "rtl",
      "glob": "ravenoc_top.sv"
    },
    {
      "id": "vendor_rtl",
      "type": "rtl",
      "glob": "vendor/ravenoc/src/ravenoc.sv"
    },
    {
      "id": "filelist",
      "type": "filelist",
      "glob": "ravenoc_filelist.f"
    },
    {
      "id": "manifest",
      "type": "resolved_config",
      "glob": "manifest.json"
    }
  ],
  "native": {
    "ipcraft": {
      "editor": {
        "extensions": {
          "noc.v1": {
            "enabled": true,
            "modes": {
              "chi_interconnect": {
                "ipxact": {
                  "mode": "target"
                }
              },
              "chi_requester_node": {
                "ipxact": {
                  "mode": "initiator"
                }
              },
              "chi_home_node": {
                "ipxact": {
                  "mode": "initiator"
                }
              },
              "chi_subordinate_node": {
                "ipxact": {
                  "mode": "initiator"
                }
              },
              "chi_peer": {
                "ipxact": {
                  "mode": "system"
                }
              }
            }
          },
          "ipcraft.config.params": {
            "enabled": true
          },
          "ipcraft.graph_config": {
            "enabled": true
          },
          "ipcraft.views": {
            "enabled": true
          },
          "ipcraft.emitters": {
            "enabled": true
          },
          "ipcraft.flows": {
            "enabled": true
          },
          "ipcraft.artifacts": {
            "enabled": true
          }
        },
        "parameters": {
          "flit_data_width": {
            "type": "int",
            "default": 32,
            "min": 8,
            "max": 512,
            "label": "Flit data width",
            "description": "FLIT_DATA_WIDTH macro value."
          },
          "flit_type_width": {
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 8,
            "label": "Flit type width",
            "description": "FLIT_TP_WIDTH macro value."
          },
          "flit_buffer_depth": {
            "type": "int",
            "default": 2,
            "min": 1,
            "max": 1024,
            "label": "Flit buffer depth",
            "description": "FLIT_BUFF macro value; must be a power of two."
          },
          "virtual_channels": {
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 16,
            "label": "Virtual channels",
            "description": "N_VIRT_CHN macro value."
          },
          "routing_algorithm": {
            "type": "string",
            "enum": [
              "xy",
              "yx"
            ],
            "labels": {
              "xy": "XY",
              "yx": "YX"
            },
            "default": "xy",
            "label": "Routing algorithm",
            "description": "ROUTING_ALG macro value."
          },
          "priority": {
            "type": "string",
            "enum": [
              "zero_high",
              "zero_low"
            ],
            "labels": {
              "zero_high": "Zero High",
              "zero_low": "Zero Low"
            },
            "default": "zero_high",
            "label": "Priority",
            "description": "H_PRIORITY macro value."
          },
          "max_packet_flits": {
            "type": "int",
            "default": 256,
            "min": 1,
            "max": 4096,
            "label": "Max packet flits",
            "description": "MAX_SZ_PKT macro value."
          },
          "axi_addr_width": {
            "type": "int",
            "default": 32,
            "min": 8,
            "max": 64,
            "label": "AXI address width",
            "description": "AXI_ADDR_WIDTH macro value."
          },
          "axi_data_width": {
            "type": "int",
            "default": 32,
            "min": 8,
            "max": 512,
            "label": "AXI data width",
            "description": "AXI_DATA_WIDTH macro value."
          },
          "axi_cdc_required": {
            "type": "string",
            "default": "all",
            "label": "AXI CDC required",
            "description": "AXI_CDC_REQ policy: all, none, or bit mask."
          },
          "bypass_cdc": {
            "type": "bool",
            "default": false,
            "label": "Bypass CDC in smoke",
            "description": "Drive generated bypass_cdc vector high in the smoke wrapper."
          }
        },
        "connection_classes": [
          {
            "id": "ravenoc_router_link",
            "roles": [
              "initiator",
              "target"
            ],
            "symmetric": false
          },
          {
            "id": "ravenoc_endpoint_link",
            "roles": [
              "initiator",
              "target"
            ],
            "symmetric": false
          }
        ],
        "modules": [
          {
            "id": "RaveTile",
            "name": "Rave Tile",
            "description": "Editable RaveNoC router tile backed by upstream RTL mesh.",
            "graph_role": "host",
            "display": {
              "label_parameter": "display_name",
              "short_label_parameter": "external_id"
            },
            "parameters": {
              "display_name": {
                "type": "string",
                "default": "Rave Tile",
                "label": "Display name",
                "description": "Name shown on the canvas."
              },
              "external_id": {
                "type": "string",
                "default": "rave_00",
                "label": "External ID",
                "description": "Stable generated artifact identifier."
              },
              "x": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Canvas X position."
              },
              "y": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Canvas Y position."
              },
              "mesh_col": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Logical RaveNoC mesh column."
              },
              "mesh_row": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Logical RaveNoC mesh row."
              }
            },
            "interfaces": [
              {
                "id": "north",
                "label": "North",
                "modes": [
                  "target"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_router_link",
                    "role": "target"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "north"
                }
              },
              {
                "id": "east",
                "label": "East",
                "modes": [
                  "initiator"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_router_link",
                    "role": "initiator"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "east"
                }
              },
              {
                "id": "south",
                "label": "South",
                "modes": [
                  "initiator"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_router_link",
                    "role": "initiator"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "south"
                }
              },
              {
                "id": "west",
                "label": "West",
                "modes": [
                  "target"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_router_link",
                    "role": "target"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "west"
                }
              },
              {
                "id": "local",
                "label": "Local",
                "modes": [
                  "target"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_endpoint_link",
                    "role": "target"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "local"
                }
              }
            ]
          },
          {
            "id": "RaveEndpoint",
            "name": "Rave Endpoint",
            "description": "Editable RaveNoC endpoint attachment for a router tile.",
            "graph_role": "attached",
            "display": {
              "label_parameter": "display_name",
              "short_label_parameter": "external_id"
            },
            "parameters": {
              "display_name": {
                "type": "string",
                "default": "Rave Endpoint",
                "label": "Display name",
                "description": "Name shown on the canvas."
              },
              "external_id": {
                "type": "string",
                "default": "rave_ep_00",
                "label": "External ID",
                "description": "Stable generated artifact identifier."
              },
              "x": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Canvas X position."
              },
              "y": {
                "type": "int",
                "default": 0,
                "configurable": false,
                "description": "Canvas Y position."
              }
            },
            "interfaces": [
              {
                "id": "noc",
                "label": "NoC",
                "modes": [
                  "initiator"
                ],
                "accepts": [
                  {
                    "class": "ravenoc_endpoint_link",
                    "role": "initiator"
                  }
                ],
                "multi_connection": false,
                "ipxact": {
                  "bus_interface": "noc"
                }
              }
            ]
          }
        ],
        "views": [
          {
            "module": "RaveTile",
            "file": "views/RaveTile.xml"
          },
          {
            "module": "RaveEndpoint",
            "file": "views/RaveEndpoint.xml"
          }
        ],
        "topologies": [
          {
            "id": "mesh",
            "label": "Mesh",
            "kind": "mesh",
            "module": "RaveTile",
            "id_pattern": "rave_{row}_{col}",
            "ports": {
              "east": "east",
              "west": "west",
              "north": "north",
              "south": "south"
            },
            "parameters": {
              "rows": {
                "label": "Rows",
                "default": 2,
                "min": 1,
                "max": 16
              },
              "cols": {
                "label": "Columns",
                "default": 2,
                "min": 1,
                "max": 16
              }
            }
          }
        ],
        "generation": {
          "engine": "ipcraft.common.v1",
          "outputs": [
            {
              "id": "config_header",
              "kind": "template",
              "path": "ravenoc_config.svh"
            }
          ],
          "module_mappings": {
            "RaveTile": "tile",
            "RaveEndpoint": "endpoint"
          },
          "coordinate_bindings": {
            "RaveTile": {
              "col": "mesh_col",
              "row": "mesh_row"
            }
          }
        }
      }
    }
  }
}
