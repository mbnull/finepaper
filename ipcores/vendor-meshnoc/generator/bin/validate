#!/usr/bin/env bash
set -euo pipefail

input=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --input)
      input="$2"
      shift 2
      ;;
    *)
      echo "unexpected argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$input" ]]; then
  echo "--input is required" >&2
  exit 2
fi
if [[ ! -f "$input" ]]; then
  echo "input does not exist: $input" >&2
  exit 3
fi

echo "Vendor MeshNoC validation succeeded: $input"
