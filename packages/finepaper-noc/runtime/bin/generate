#!/usr/bin/env ruby
# frozen_string_literal: true

# The Finepaper Package process contract is intentionally small. This adapter
# translates the NocDesign passed by Finepaper into the legacy generator input;
# Core never needs to know about that graph schema or its DRC classes.

require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'tmpdir'

HDL_IDENTIFIER = /\A[A-Za-z_][A-Za-z0-9_]*\z/

def write_result(path, success:, artifacts: [], diagnostics: [])
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(
                     'success' => success,
                     'artifacts' => artifacts,
                     'diagnostics' => diagnostics
                   ) + "\n")
end

def fail_operation(message, result_path)
  warn "error: #{message}"
  write_result(result_path,
               success: false,
               diagnostics: [{
                 'severity' => 'error',
                 'code' => 'finepaper_noc.adapter_failed',
                 'message' => message,
                 'source' => 'finepaper.noc'
               }]) if result_path
  exit 1
end

# Finepaper validates Package parameters and materializes their defaults before
# invoking a Package process. Keep this boundary strict so the adapter never
# carries a second, drifting copy of defaults from package.json.
def required_parameter(values, id, owner)
  raise "#{owner} parameters must be an object" unless values.is_a?(Hash)
  raise "#{owner} parameter #{id} is required" unless values.key?(id)

  values[id]
end

def required_integer_parameter(values, id, owner)
  value = required_parameter(values, id, owner)
  raise "#{owner} parameter #{id} must be an integer" unless value.is_a?(Integer)

  value
end

def required_string_parameter(values, id, owner)
  value = required_parameter(values, id, owner)
  unless value.is_a?(String) && !value.empty?
    raise "#{owner} parameter #{id} must be a non-empty string"
  end

  value
end

def required_boolean_parameter(values, id, owner)
  value = required_parameter(values, id, owner)
  unless value == true || value == false
    raise "#{owner} parameter #{id} must be a boolean"
  end

  value
end

def require_hdl_identifier(value, description)
  unless value.is_a?(String) && value.match?(HDL_IDENTIFIER)
    raise "#{description} must be a Verilog identifier ([A-Za-z_][A-Za-z0-9_]*)"
  end

  value
end

def endpoint_slot_key(endpoint)
  slot = endpoint.dig('attachment', 'slot').to_s
  return [0, slot.to_i, endpoint.fetch('id')] if slot.match?(/\A\d+\z/)

  [1, slot, endpoint.fetch('id')]
end

def router_configuration_map(design)
  configurations = design.fetch('elementConfigurations', [])
  raise 'elementConfigurations must be an array' unless configurations.is_a?(Array)

  configurations.each_with_object({}) do |configuration, result|
    next unless configuration.is_a?(Hash)
    next unless configuration['propertySet'] == 'router.microarchitecture'

    element = configuration['element']
    next unless element.is_a?(Hash) && element['kind'] == 'router'

    match = /\Ar-(\d+)-(\d+)\z/.match(element['id'].to_s)
    raise "invalid Router id #{element['id']}" unless match

    properties = configuration.fetch('properties', {})
    raise 'Router element configuration properties must be an object' unless properties.is_a?(Hash)

    mapped = {}
    mapped['routing_algorithm'] = properties['routingAlgorithm'] if properties.key?('routingAlgorithm')
    mapped['vc_count'] = properties['virtualChannels'] if properties.key?('virtualChannels')
    mapped['buffer_depth'] = properties['bufferDepth'] if properties.key?('bufferDepth')
    result["xp_#{match[1]}_#{match[2]}"] = mapped unless mapped.empty?
  end
end

def legacy_input(design)
  raise 'design format must be finepaper.noc-design' unless design['format'] == 'finepaper.noc-design'
  raise 'only mesh topology is supported' unless design.dig('topology', 'type') == 'mesh'

  rows = design.dig('topology', 'rows')
  columns = design.dig('topology', 'columns')
  unless rows.is_a?(Integer) && columns.is_a?(Integer) && rows.positive? && columns.positive?
    raise 'mesh rows and columns must be positive integers'
  end

  parameters = design.fetch('parameters')
  raise 'design parameters must be an object' unless parameters.is_a?(Hash)
  endpoints = design.fetch('endpoints', [])
  raise 'endpoints must be an array' unless endpoints.is_a?(Array)
  design_id = require_hdl_identifier(design.fetch('id'), 'design id')

  endpoint_map = Hash.new { |map, key| map[key] = [] }
  endpoint_modules = endpoints.sort_by { |endpoint| endpoint.fetch('id') }.map do |endpoint|
    id = require_hdl_identifier(endpoint.fetch('id'), 'endpoint id')
    type = endpoint.fetch('type')
    unless type.is_a?(String) && !type.empty?
      raise "endpoint #{id} type must be a non-empty string"
    end
    endpoint_parameters = endpoint.fetch('parameters')
    raise "endpoint #{id} parameters must be an object" unless endpoint_parameters.is_a?(Hash)
    router = endpoint.dig('attachment', 'router')
    raise "endpoint #{id} has no router attachment" unless router.is_a?(Hash)

    x = router['x']
    y = router['y']
    unless x.is_a?(Integer) && y.is_a?(Integer) && x.between?(0, columns - 1) && y.between?(0, rows - 1)
      raise "endpoint #{id} attaches outside the mesh"
    end

    endpoint_map["xp_#{x}_#{y}"] << endpoint
    {
      'id' => id,
      'ipcore' => 'finepaper.noc',
      'instance' => 'noc_0',
      'type' => 'Endpoint',
      'parameters' => {
        'type' => type,
        'protocol' => required_string_parameter(
          endpoint_parameters, 'protocol', "endpoint #{id}"
        ),
        'data_width' => required_integer_parameter(
          endpoint_parameters, 'dataWidth', "endpoint #{id}"
        ),
        'buffer_depth' => required_integer_parameter(
          endpoint_parameters, 'bufferDepth', "endpoint #{id}"
        ),
        'qos_enabled' => required_boolean_parameter(
          endpoint_parameters, 'qosEnabled', "endpoint #{id}"
        )
      }
    }
  end

  endpoint_map.transform_values! do |router_endpoints|
    router_endpoints.sort_by { |endpoint| endpoint_slot_key(endpoint) }.map { |endpoint| endpoint.fetch('id') }
  end
  router_configs = router_configuration_map(design)

  {
    'schema' => 'finepaper-ipcore-graph-v1',
    # The display name is intentionally not used as a file or HDL token.
    'name' => design_id,
    'ipcore' => 'finepaper.noc',
    'instance' => 'noc_0',
    'version' => design.dig('package', 'version') || '1.0.0',
    'ipcore_state' => [{
      'ipcore' => 'finepaper.noc',
      'instance' => 'noc_0',
      'state' => {
        'global_parameters' => {
          'data_width' => required_integer_parameter(
            parameters, 'dataWidth', 'design'
          ),
          'flit_width' => required_integer_parameter(
            parameters, 'flitWidth', 'design'
          ),
          'addr_width' => required_integer_parameter(
            parameters, 'addrWidth', 'design'
          ),
          'mesh' => {
            'width' => columns,
            'height' => rows,
            'endpoint_map' => endpoint_map,
            'router_configs' => router_configs
          }
        }
      }
    }],
    'modules' => endpoint_modules,
    'connections' => []
  }
end

def artifact_list(output_dir, design_name)
  files = Dir.glob(File.join(output_dir, '**', '*')).select { |path| File.file?(path) }.sort
  files.map.with_index do |path, index|
    relative = path.delete_prefix(output_dir + File::SEPARATOR)
    type = if File.basename(path) == 'filelist.f'
             'filelist'
           elsif %w[.v .sv].include?(File.extname(path).downcase)
             'rtl'
           else
             'generated'
           end
    {
      'id' => format('artifact-%03d', index + 1),
      'type' => type,
      'path' => relative,
      'primary' => File.basename(path) == "#{design_name}_top.v"
    }
  end
end

options = {}
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: generate (validate|generate) --design DESIGN --result RESULT [--output OUTPUT]'
  opts.on('--design PATH') { |value| options[:design] = value }
  opts.on('--output PATH') { |value| options[:output] = value }
  opts.on('--result PATH') { |value| options[:result] = value }
end

command = ARGV.shift
parser.parse!
unless %w[validate generate].include?(command)
  fail_operation('first argument must be validate or generate', options[:result])
end
fail_operation('--design is required', options[:result]) unless options[:design]
fail_operation('--result is required', options[:result]) unless options[:result]
fail_operation('--output is required for generate', options[:result]) if command == 'generate' && !options[:output]

begin
  design = JSON.parse(File.read(options[:design]))
  legacy_root = File.expand_path('../legacy-generator', __dir__)
  legacy_program = File.join(legacy_root, 'bin', command == 'validate' ? 'drc' : 'generate')
  raise 'legacy generator is missing from this Package' unless File.file?(legacy_program)

  Dir.mktmpdir('finepaper-noc-adapter-') do |temporary_directory|
    input_path = File.join(temporary_directory, 'legacy-input.json')
    File.write(input_path, JSON.generate(legacy_input(design)))
    arguments = ['ruby', legacy_program, '-i', input_path]
    if command == 'generate'
      FileUtils.mkdir_p(options[:output])
      arguments.concat(['-o', File.expand_path(options[:output]), '-t', File.join(legacy_root, 'template')])
    end
    stdout, stderr, status = Open3.capture3(*arguments, chdir: legacy_root)
    $stdout.write(stdout)
    $stderr.write(stderr)
    raise(stderr.strip.empty? ? "legacy #{command} failed" : stderr.strip) unless status.success?
  end

  design_id = require_hdl_identifier(design.fetch('id'), 'design id')
  if command == 'generate'
    intent_path = File.join(
      File.expand_path(options[:output]),
      "#{design_id}_design_intent.json"
    )
    File.write(intent_path, JSON.pretty_generate(design) + "\n")
  end
  artifacts = command == 'generate' ? artifact_list(File.expand_path(options[:output]), design_id) : []
  raise 'legacy generator did not produce any artifacts' if command == 'generate' && artifacts.empty?

  write_result(options[:result], success: true, artifacts: artifacts)
rescue StandardError => error
  fail_operation(error.message, options[:result])
end
