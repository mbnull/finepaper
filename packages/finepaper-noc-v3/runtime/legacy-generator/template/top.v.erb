<%
  xs = @xps.map(&:x)
  ys = @xps.map(&:y)
  mesh_width = xs.empty? ? 0 : xs.max - xs.min + 1
  mesh_height = ys.empty? ? 0 : ys.max - ys.min + 1
  catalog = @noc.catalog
  endpoint_by_id = @endpoints.to_h { |ep| [ep.id, ep] }
  domain_rendering = @domain_rtl_rendering
  clock_domains = domain_rendering.fetch('clockDomains')
  router_signals = domain_rendering.fetch('routerSignals')
  endpoint_signals = domain_rendering.fetch('endpointSignals')
  router_traffic = domain_rendering.fetch('routerTraffic')
  endpoint_attachments = domain_rendering.fetch('endpointAttachments')
  clock_port_mode = domain_rendering.fetch('clockPortMode')
%>
//----------------------------------------------------------------------------
// Auto-generated by finepaper | NoC: <%= @name %> v<%= @version %>
//----------------------------------------------------------------------------
//#========================================================================
//#
//#  <%= @name %>: generated ready/valid forwarding integration wrapper
//#
//#========================================================================
//#
//# Topology Summary
//# ================
//  - mesh_size      : <%= mesh_width %> x <%= mesh_height %>
//  - xp_count       : <%= @xps.size %>
//  - link_count     : <%= @connections.size %>
//  - endpoint_count : <%= @endpoints.size %>
//  - master_count   : <%= catalog[:masters].size %>
//  - slave_count    : <%= catalog[:slaves].size %>
//  - variant_mode   : partitioned xp signature modules
//  - ni_mode        : one instance per Endpoint; modules reused by signature
//#
//# Global Configuration Parameters
//# ===============================
<% @parameters.sort_by { |key, _| key.to_s }.each do |key, value| %>
//  - <%= key.to_s.upcase.ljust(20) %> = <%= value %>
<% end %>
//#
//# XP Inventory
//# ============
<% @xps.each do |xp| %>
//  - NID<%= xp.node_id(@noc).to_s.rjust(3, '0') %> <%= xp.id.ljust(16) %> xy=(<%= xp.x %>,<%= xp.y %>) endpoints=<%= xp.endpoints.empty? ? 'none' : xp.endpoints.join(',') %> route=<%= xp.config[:routing_algorithm] %> vc=<%= xp.config[:vc_count] %> depth=<%= xp.config[:buffer_depth] %>
<% end %>
//#
//# Endpoint / Device Inventory
//# ===========================
<% @endpoints.each do |ep| %>
//  - <%= ep.id.ljust(16) %> role=<%= ep.type.ljust(6) %> protocol=<%= ep.protocol.ljust(8) %> data_width=<%= ep.data_width %> buffer_depth=<%= ep.config[:buffer_depth] %> qos=<%= ep.config[:qos_enabled] ? 'enabled' : 'disabled' %>
<% end %>
//#
//# Mesh Link Inventory
//# ===================
<% @connections.each_with_index do |conn, index| %>
//  - L<%= index.to_s.rjust(3, '0') %> <%= conn.from %> <-> <%= conn.to %> dir=<%= conn.dir || 'auto' %> bundle=payload,valid,ready forwarding=fixed-shell
<% end %>
//#
//# Active Timing Domains
//# =====================
//  - port_mode=<%= clock_port_mode %>
<% clock_domains.each do |domain| %>
//  - <%= domain.fetch('domain') %> clock=<%= domain.fetch('clockSignal') %> local_reset=<%= domain.fetch('resetSignal') %> release_stages=<%= domain.fetch('resetReleaseStages') %>
<% end %>
//----------------------------------------------------------------------------

module <%= @name %>_top #(
  parameter DATA_WIDTH = <%= @parameters['data_width'] %>,
  parameter FLIT_WIDTH = <%= @parameters['flit_width'] %>,
  parameter ADDR_WIDTH = <%= @parameters['addr_width'] %>
) (
<%
  top_ports = clock_domains.map do |domain|
    "  input  logic #{domain.fetch('clockSignal')}"
  end
  top_ports << '  input  logic rst_n'
  @endpoints.each do |ep|
    if ep.ports&.any?
      ep.ports.each do |port|
        top_ports << "  #{port.dir.ljust(6)} logic#{port.width ? " #{port.width}" : ''} #{ep.id}_#{port.name}"
      end
    else
      top_ports << "  input  logic [FLIT_WIDTH-1:0] #{ep.id}_flit_in"
      top_ports << "  input  logic                  #{ep.id}_flit_in_valid"
      top_ports << "  output logic                  #{ep.id}_flit_in_ready"
      top_ports << "  output logic [FLIT_WIDTH-1:0] #{ep.id}_flit_out"
      top_ports << "  output logic                  #{ep.id}_flit_out_valid"
      top_ports << "  input  logic                  #{ep.id}_flit_out_ready"
    end
  end
%>
<%= top_ports.join(",\n") %>
);

  //# Domain Clock and Reset Infrastructure
  //# =====================================
  // rst_n is one coordinated asynchronous request. Every active timing
  // Domain releases it synchronously using its Package-configured depth.
<% clock_domains.each do |domain| %>
  logic <%= domain.fetch('resetSignal') %>;
  fp_reset_synchronizer #(
    .STAGES(<%= domain.fetch('resetReleaseStages') %>)
  ) u_reset_<%= domain.fetch('token') %> (
    .clk(<%= domain.fetch('clockSignal') %>),
    .async_reset_n(rst_n),
    .reset_n(<%= domain.fetch('resetSignal') %>)
  );

<% end %>

  //# Internal Signals - Mesh Link Bundle Declarations
  //# ================================================
  // Each physical Router-Link has one payload/valid/ready bundle in each
  // direction. Ready travels opposite its corresponding payload and valid.
<%
  router_bridges = router_traffic.values.sort_by do |bridge|
    bridge.fetch('baseSignal')
  end
  router_bridges.each do |bridge|
    [bridge.fetch('sourceSignal'), bridge.fetch('destinationSignal')].uniq.each do |signal| %>
  logic [FLIT_WIDTH-1:0] <%= signal %>_flit;
  logic                  <%= signal %>_valid;
  logic                  <%= signal %>_ready;
<%  end
  end %>

  //# Device Attachment Bundle Declarations
  //# =====================================
  // NI-to-router bundles model protocol adapters, request queues, and return
  // paths. Both directions use the same payload/valid/ready contract as mesh
  // links; no attachment silently assumes permanent valid or permanent ready.
<%
  @xps.each do |xp|
    next if xp.endpoints.empty?
    xp.endpoints.each do |ep_id|
      attachment = endpoint_attachments.fetch(ep_id)
      [attachment.fetch('endpointToRouter'),
       attachment.fetch('routerToEndpoint')].each do |bridge|
        [bridge.fetch('sourceSignal'), bridge.fetch('destinationSignal')].uniq.each do |signal| %>
  logic [FLIT_WIDTH-1:0] <%= signal %>_flit;
  logic                  <%= signal %>_valid;
  logic                  <%= signal %>_ready;
<%      end
      end
    end
  end %>

  //# Materialized Clock-Domain Bridges
  //# =================================
  // A crossing physical edge owns one FIFO per traffic orientation. Same-
  // Domain traffic retains one direct bundle and therefore has no CDC cell.
<%
  attachment_bridges = endpoint_attachments.values.flat_map do |attachment|
    [attachment.fetch('routerToEndpoint'), attachment.fetch('endpointToRouter')]
  end
  (router_bridges + attachment_bridges)
    .select { |bridge| bridge.fetch('crossing') }
    .sort_by { |bridge| bridge.fetch('instance') }
    .each do |bridge|
      source = bridge.fetch('sourceSignal')
      destination = bridge.fetch('destinationSignal')
      source_domain = bridge.fetch('sourceDomain')
      destination_domain = bridge.fetch('destinationDomain') %>
  fp_async_ready_valid_fifo #(
    .PAYLOAD_WIDTH(FLIT_WIDTH),
    .DEPTH(<%= bridge.fetch('fifoDepth') %>),
    .SYNC_STAGES(<%= bridge.fetch('synchronizerStages') %>)
  ) <%= bridge.fetch('instance') %> (
    .src_clk_i(<%= source_domain.fetch('clockSignal') %>),
    .src_rst_ni(<%= source_domain.fetch('resetSignal') %>),
    .src_payload_i(<%= source %>_flit),
    .src_valid_i(<%= source %>_valid),
    .src_ready_o(<%= source %>_ready),
    .dst_clk_i(<%= destination_domain.fetch('clockSignal') %>),
    .dst_rst_ni(<%= destination_domain.fetch('resetSignal') %>),
    .dst_payload_o(<%= destination %>_flit),
    .dst_valid_o(<%= destination %>_valid),
    .dst_ready_i(<%= destination %>_ready)
  );

<% end %>

  //# Router Instance Stitching
  //# =========================
<%
  @xps.each do |xp|
    module_name = @xp_module_lookup.fetch(xp.id)
    router_domain = router_signals.fetch(xp.id) %>
  <%= module_name %> #(
    .DATA_WIDTH(DATA_WIDTH),
    .FLIT_WIDTH(FLIT_WIDTH),
    .ADDR_WIDTH(ADDR_WIDTH)
  ) u_<%= xp.id %> (
    .clk(<%= router_domain.fetch('clockSignal') %>),
    .rst_n(<%= router_domain.fetch('resetSignal') %>)<%
    # Connect to neighboring routers.
    @xp_link_directions_by_id.fetch(xp.id).each do |link|
        nb = link[:neighbor]
        port = link[:port] || link[:abbr]
        outbound = router_traffic.fetch([xp.id, nb.id])
        inbound = router_traffic.fetch([nb.id, xp.id]) %>,
    .flit_out_<%= port %>(<%= outbound.fetch('sourceSignal') %>_flit),
    .flit_out_<%= port %>_valid(<%= outbound.fetch('sourceSignal') %>_valid),
    .flit_out_<%= port %>_ready(<%= outbound.fetch('sourceSignal') %>_ready),
    .flit_in_<%= port %>(<%= inbound.fetch('destinationSignal') %>_flit),
    .flit_in_<%= port %>_valid(<%= inbound.fetch('destinationSignal') %>_valid),
    .flit_in_<%= port %>_ready(<%= inbound.fetch('destinationSignal') %>_ready)<% end
    # Connect Endpoint NIs through their attachment bridge records.
    xp.endpoints.each_with_index do |ep_id, idx|
        attachment = endpoint_attachments.fetch(ep_id)
        inbound = attachment.fetch('endpointToRouter')
        outbound = attachment.fetch('routerToEndpoint') %>,
    .local<%= idx %>_flit_in(<%= inbound.fetch('destinationSignal') %>_flit),
    .local<%= idx %>_flit_in_valid(<%= inbound.fetch('destinationSignal') %>_valid),
    .local<%= idx %>_flit_in_ready(<%= inbound.fetch('destinationSignal') %>_ready),
    .local<%= idx %>_flit_out(<%= outbound.fetch('sourceSignal') %>_flit),
    .local<%= idx %>_flit_out_valid(<%= outbound.fetch('sourceSignal') %>_valid),
    .local<%= idx %>_flit_out_ready(<%= outbound.fetch('sourceSignal') %>_ready)<% end
%>
  );

<% end %>
  //# Network Interface Instance Stitching
  //# ====================================
<%
  @xps.each do |xp|
    xp.endpoints.each do |ep_id|
      ep = endpoint_by_id.fetch(ep_id)
      ni_module_name = @ni_module_lookup.fetch(ep_id)
      endpoint_domain = endpoint_signals.fetch(ep_id)
      attachment = endpoint_attachments.fetch(ep_id)
      endpoint_to_router = attachment.fetch('endpointToRouter')
      router_to_endpoint = attachment.fetch('routerToEndpoint')
      port_prefix = 'ep0' %>
  <%= ni_module_name %> #(
    .FLIT_WIDTH(FLIT_WIDTH),
    .NUM_ENDPOINTS(1)
  ) u_ni_<%= ep_id %> (
    .clk(<%= endpoint_domain.fetch('clockSignal') %>),
    .rst_n(<%= endpoint_domain.fetch('resetSignal') %>)<%
      if ep.ports&.any?
        ep.ports.each { |p| %>,
    .<%= port_prefix %>_<%= p.name %>(<%= ep_id %>_<%= p.name %>)<% }
      else %>,
    .<%= port_prefix %>_flit_in(<%= ep_id %>_flit_in),
    .<%= port_prefix %>_flit_in_valid(<%= ep_id %>_flit_in_valid),
    .<%= port_prefix %>_flit_in_ready(<%= ep_id %>_flit_in_ready),
    .<%= port_prefix %>_flit_out(<%= ep_id %>_flit_out),
    .<%= port_prefix %>_flit_out_valid(<%= ep_id %>_flit_out_valid),
    .<%= port_prefix %>_flit_out_ready(<%= ep_id %>_flit_out_ready)<% end %>,
    .<%= port_prefix %>_router_flit_in(<%= endpoint_to_router.fetch('sourceSignal') %>_flit),
    .<%= port_prefix %>_router_flit_in_valid(<%= endpoint_to_router.fetch('sourceSignal') %>_valid),
    .<%= port_prefix %>_router_flit_in_ready(<%= endpoint_to_router.fetch('sourceSignal') %>_ready),
    .<%= port_prefix %>_router_flit_out(<%= router_to_endpoint.fetch('destinationSignal') %>_flit),
    .<%= port_prefix %>_router_flit_out_valid(<%= router_to_endpoint.fetch('destinationSignal') %>_valid),
    .<%= port_prefix %>_router_flit_out_ready(<%= router_to_endpoint.fetch('destinationSignal') %>_ready)
  );

<%  end
  end %>
endmodule
