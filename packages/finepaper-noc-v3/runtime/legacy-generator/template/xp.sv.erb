<%
  module_name = @xp_module_name || "xp_router_#{@xp.id}"
  local_port_count = @xp_local_port_count || @xp.endpoints.size
  direction_order = [
    { name: :east,  abbr: 'e', label: 'E' },
    { name: :west,  abbr: 'w', label: 'W' },
    { name: :north, abbr: 'n', label: 'N' },
    { name: :south, abbr: 's', label: 'S' }
  ]
  active_links = if @xp_port_directions
                   @xp_port_directions
                 else
                   @xp.neighbors(@noc).filter_map do |nb|
                     conn = @connections.find { |c| (c.from == @xp.id && c.to == nb.id) || (c.to == @xp.id && c.from == nb.id) }
                     next unless conn

                     { name: (conn.dir || 'auto').to_s.downcase.to_sym, abbr: (conn.dir || 'a').to_s[0], neighbor: nb, connection: conn }
                   end
                 end
  links_by_direction = active_links.group_by { |link| link[:name] }
  forwarding_ports = if @xp_port_directions
                       active_links.map do |link|
                         port = link[:port] || link[:abbr]
                         { input: "flit_in_#{port}", output: "flit_out_#{port}" }
                       end + local_port_count.times.map do |index|
                         { input: "local#{index}_flit_in", output: "local#{index}_flit_out" }
                       end
                     else
                       neighbor_ports = @xp.neighbors(@noc).map do |neighbor|
                         { input: "flit_in_#{neighbor.id}", output: "flit_out_#{neighbor.id}" }
                       end
                       endpoint_ports = @xp.endpoints.filter_map do |endpoint_id|
                         endpoint = @noc.endpoints.find { |candidate| candidate.id == endpoint_id }
                         next if endpoint&.ports&.any?

                         { input: "#{endpoint_id}_flit_in", output: "#{endpoint_id}_flit_out" }
                       end
                       neighbor_ports + endpoint_ports
                     end
  forwarding_map = forwarding_ports.each_with_index.map do |source, index|
    { source: source, destination: forwarding_ports[(index + 1) % forwarding_ports.size] }
  end
  has_external_ports = if @xp_port_directions
                         active_links.any? || local_port_count.positive?
                       else
                         @xp.neighbors(@noc).any? || @xp.endpoints.any?
                       end
%>
//----------------------------------------------------------------------------
// Auto-generated by finepaper | NoC: <%= @name %> v<%= @version %>
//----------------------------------------------------------------------------
//#========================================================================
//#
//#  SMXP: Synthetic Mesh Cross Point
//#
//#========================================================================
//#
//# Module
//# ======
//  - module_name       : <%= module_name %>
//  - source_xp         : <%= @xp.id %>
//  - node_id           : <%= @xp.node_id(@noc) %>
//  - position          : (<%= @xp.x %>, <%= @xp.y %>)
//  - variant_signature : <%= @xp_variant_signature || 'per-xp' %>
//  - local_ports       : <%= local_port_count %>
//#
//# Crosspoint Configuration
//# ========================
//  - DATA_WIDTH        : <%= @parameters['data_width'] %>
//  - FLIT_WIDTH        : <%= @parameters['flit_width'] %>
//  - ADDR_WIDTH        : <%= @parameters['addr_width'] %>
//  - requested_routing : <%= @xp.config[:routing_algorithm] %> (not realized by this shell)
//  - requested_vcs     : <%= @xp.config[:vc_count] %> (not realized by this shell)
//  - stage_depth       : 1 (foundation forwarding stage)
//  - endpoint_slots    : <%= @xp.endpoints.empty? ? 'none' : @xp.endpoints.join(', ') %>
//#
//# Mesh Port Matrix
//# ================
<% direction_order.each do |dir| %>
//# Mesh Port: <%= dir[:label] %>
<% links = links_by_direction.fetch(dir[:name], [])
   if links.empty? %>
//  - state            : not present for this variant
<% else
     links.each_with_index do |link, index|
       neighbor = link[:neighbor]&.id || 'external'
       port = link[:port] || link[:abbr] || dir[:abbr] %>
//  - slice<%= index %>           : neighbor=<%= neighbor %> port_suffix=<%= port %> bundle=payload,valid,ready forwarding=fixed-shell
<%   end
   end %>
<% end %>
//#
//# Foundation Forwarding Contract
//# ==============================
//  - Every physical link and local attachment is a bidirectional
//    payload/valid/ready bundle.
//  - The shell applies one fixed cyclic permutation across its ingress and
//    egress ports. Each ingress has exactly one egress; flits are never copied.
//  - A one-entry registered stage per mapping holds payload and valid while the
//    destination applies backpressure and breaks combinational fabric loops.
//  - This is deliberately only a forwarding foundation. It is not a complete
//    NoC router: it does not inspect destinations, arbitrate, implement virtual
//    channels, or claim REQ/RSP/DAT/SNP/PUB routing behavior.
<% forwarding_map.each do |mapping| %>
//  - <%= mapping[:source][:input] %> -> <%= mapping[:destination][:output] %>
<% end %>
//----------------------------------------------------------------------------

module <%= module_name %> #(
  parameter DATA_WIDTH = <%= @parameters['data_width'] %>,
  parameter FLIT_WIDTH = <%= @parameters['flit_width'] %>,
  parameter ADDR_WIDTH = <%= @parameters['addr_width'] %>
) (
  input  logic clk,
  input  logic rst_n<%= has_external_ports ? ',' : '' %>
  // <%= @xp_port_directions ? "Local endpoint slots: #{local_port_count}" : "Endpoints: #{@xp.endpoints.join(', ')}" %>
<%
  ports = []
  if @xp_port_directions
    # Variant XP modules use direction-based ports so one module can be reused
    # by every coordinate with the same E/W/N/S connectivity.
    @xp_port_directions.each do |link|
      port = link[:port] || link[:abbr]
      ports << "  // Link #{port.upcase}\n  input  logic [FLIT_WIDTH-1:0] flit_in_#{port}"
      ports << "  input  logic                  flit_in_#{port}_valid"
      ports << "  output logic                  flit_in_#{port}_ready"
      ports << "  output logic [FLIT_WIDTH-1:0] flit_out_#{port}"
      ports << "  output logic                  flit_out_#{port}_valid"
      ports << "  input  logic                  flit_out_#{port}_ready"
    end
    local_port_count.times do |idx|
      ports << "  input  logic [FLIT_WIDTH-1:0] local#{idx}_flit_in"
      ports << "  input  logic                  local#{idx}_flit_in_valid"
      ports << "  output logic                  local#{idx}_flit_in_ready"
      ports << "  output logic [FLIT_WIDTH-1:0] local#{idx}_flit_out"
      ports << "  output logic                  local#{idx}_flit_out_valid"
      ports << "  input  logic                  local#{idx}_flit_out_ready"
    end
  else
    # Neighbor connection ports
    @xp.neighbors(@noc).each do |nb|
      dir = @connections.find { |c| (c.from == @xp.id && c.to == nb.id) || (c.to == @xp.id && c.from == nb.id) }&.dir
      ports << "  // Link to #{nb.id} (#{dir})\n  input  logic [FLIT_WIDTH-1:0] flit_in_#{nb.id}"
      ports << "  input  logic                  flit_in_#{nb.id}_valid"
      ports << "  output logic                  flit_in_#{nb.id}_ready"
      ports << "  output logic [FLIT_WIDTH-1:0] flit_out_#{nb.id}"
      ports << "  output logic                  flit_out_#{nb.id}_valid"
      ports << "  input  logic                  flit_out_#{nb.id}_ready"
    end
    # Endpoint ports
    @xp.endpoints.each do |ep_id|
      ep = @noc.endpoints.find { |e| e.id == ep_id }
      if ep&.ports&.any?
        ep.ports.each { |p| ports << "  #{p.dir.ljust(6)} logic#{p.width ? " #{p.width}" : ''} #{ep_id}_#{p.name}" }
      else
        ports << "  input  logic [FLIT_WIDTH-1:0] #{ep_id}_flit_in"
        ports << "  input  logic                  #{ep_id}_flit_in_valid"
        ports << "  output logic                  #{ep_id}_flit_in_ready"
        ports << "  output logic [FLIT_WIDTH-1:0] #{ep_id}_flit_out"
        ports << "  output logic                  #{ep_id}_flit_out_valid"
        ports << "  input  logic                  #{ep_id}_flit_out_ready"
      end
    end
  end
%>
<%= ports.join(",\n") %>
);

  // Fixed one-to-one forwarding shell. Each stage intentionally accepts a new
  // flit only while empty; this keeps ready independent of downstream ready,
  // makes backpressure unambiguous, and avoids combinational loops across a
  // fabric. A production router can replace this shell behind the same bundles.
<% forwarding_map.each_with_index do |mapping, index|
     source = mapping[:source]
     destination = mapping[:destination] %>
  logic [FLIT_WIDTH-1:0] forward_<%= index %>_payload_q;
  logic                  forward_<%= index %>_valid_q;

  assign <%= destination[:output] %>       = forward_<%= index %>_payload_q;
  assign <%= destination[:output] %>_valid = forward_<%= index %>_valid_q;
  assign <%= source[:input] %>_ready       = rst_n && !forward_<%= index %>_valid_q;

  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      forward_<%= index %>_payload_q <= '0;
      forward_<%= index %>_valid_q   <= 1'b0;
    end else begin
      if (forward_<%= index %>_valid_q && <%= destination[:output] %>_ready)
        forward_<%= index %>_valid_q <= 1'b0;

      if (<%= source[:input] %>_valid && <%= source[:input] %>_ready) begin
        forward_<%= index %>_payload_q <= <%= source[:input] %>;
        forward_<%= index %>_valid_q   <= 1'b1;
      end
    end
  end
<% end %>

<% unless @xp_port_directions
     @xp.endpoints.each do |endpoint_id|
       endpoint = @noc.endpoints.find { |candidate| candidate.id == endpoint_id }
       next unless endpoint&.ports&.any?
       endpoint.ports.each do |port|
         next unless port.dir == 'output' %>
  // Protocol-specific endpoint adaptation is outside this forwarding shell.
  assign <%= endpoint_id %>_<%= port.name %> = '0;
<%     end
     end
   end %>
endmodule
