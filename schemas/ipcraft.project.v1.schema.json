{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.project.v1",
  "title": "IpCraft Project V1",
  "description": "Strict ProjectDesign root schema. Unknown top-level fields are rejected; forward-compatible data is limited to metadata and package-owned extension blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "packages", "components"],
  "properties": {
    "schema": { "const": "ipcraft.project.v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "topologies": {
      "type": "array",
      "items": { "$ref": "#/$defs/topology" }
    },
    "constraints": { "$ref": "#/$defs/openObject" },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/view" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/openObject" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/openObject" }
    },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extensionBlock" }
    },
    "metadata": { "$ref": "#/$defs/openObject" }
  },
  "$defs": {
    "openObject": {
      "type": "object",
      "additionalProperties": true
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "packageRef"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "packageRef": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/openObject" },
        "config": {
          "allOf": [
            { "$ref": "#/$defs/openObject" },
            {
              "not": {
                "anyOf": [
                  { "required": ["x"] },
                  { "required": ["y"] },
                  { "required": ["node_width"] },
                  { "required": ["node_height"] },
                  { "required": ["collapsed"] },
                  { "required": ["waypoints"] },
                  { "required": ["zoom"] },
                  { "required": ["pan"] }
                ]
              }
            }
          ]
        },
        "metadata": { "$ref": "#/$defs/openObject" },
        "extensionData": { "$ref": "#/$defs/openObject" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerComponentId", "type", "role", "direction", "protocol"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ownerComponentId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "clockRef": { "type": "string", "minLength": 1 },
        "resetRef": { "type": "string", "minLength": 1 },
        "config": { "$ref": "#/$defs/openObject" },
        "metadata": { "$ref": "#/$defs/openObject" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "interface"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "interface": { "type": "string", "minLength": 1 }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "kind": {
          "type": "string",
          "not": { "const": "attachment" }
        },
        "config": { "$ref": "#/$defs/openObject" },
        "constraints": { "$ref": "#/$defs/openObject" },
        "metadata": { "$ref": "#/$defs/openObject" }
      }
    },
    "topology": {
      "oneOf": [
        { "$ref": "#/$defs/topologyGraph" },
        { "$ref": "#/$defs/topologyParametric" }
      ]
    },
    "topologyCommon": {
      "type": "object",
      "required": ["id", "schema", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "ownerComponentId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "providerRef": { "type": "string", "minLength": 1 },
        "parameters": { "$ref": "#/$defs/openObject" },
        "constraints": { "$ref": "#/$defs/openObject" },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyAttachment" }
        },
        "routing": { "$ref": "#/$defs/openObject" },
        "metadata": { "$ref": "#/$defs/openObject" }
      }
    },
    "topologyGraph": {
      "allOf": [
        { "$ref": "#/$defs/topologyCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "links"],
          "properties": {
            "id": true,
            "schema": { "const": "ipcraft.topology.graph.v1" },
            "ownerComponentId": true,
            "kind": {
              "enum": ["explicit_graph", "expanded_parametric"]
            },
            "family": true,
            "providerRef": true,
            "parameters": true,
            "constraints": true,
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/openObject" }
            },
            "links": {
              "type": "array",
              "items": { "$ref": "#/$defs/openObject" }
            },
            "attachments": true,
            "routing": true,
            "metadata": true
          }
        }
      ]
    },
    "topologyParametric": {
      "allOf": [
        { "$ref": "#/$defs/topologyCommon" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "parameters"],
          "not": {
            "anyOf": [
              { "required": ["nodes"] },
              { "required": ["links"] }
            ]
          },
          "properties": {
            "id": true,
            "schema": { "const": "ipcraft.topology.parametric.v1" },
            "ownerComponentId": true,
            "kind": { "const": "parametric" },
            "family": true,
            "providerRef": true,
            "parameters": true,
            "constraints": true,
            "attachments": true,
            "routing": true,
            "metadata": true
          }
        }
      ]
    },
    "topologyAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "topologyId": { "type": "string", "minLength": 1 },
        "attachmentPoint": { "$ref": "#/$defs/openObject" },
        "componentRef": { "type": "string", "minLength": 1 },
        "interfaceRef": { "type": "string", "minLength": 1 },
        "adapterRef": { "type": "string", "minLength": 1 },
        "config": { "$ref": "#/$defs/openObject" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "kind", "targetRef", "providerRef"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schema": { "const": "ipcraft.view.v1" },
        "kind": { "type": "string", "minLength": 1 },
        "targetRef": { "type": "string", "minLength": 1 },
        "providerRef": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "templates": { "$ref": "#/$defs/openObject" },
        "portGrouping": { "$ref": "#/$defs/openObject" },
        "labels": { "$ref": "#/$defs/openObject" },
        "badges": { "$ref": "#/$defs/openObject" },
        "propertyGroups": { "$ref": "#/$defs/openObject" },
        "layoutPreference": { "$ref": "#/$defs/openObject" },
        "interactionAffordances": { "$ref": "#/$defs/openObject" },
        "diagnosticsOverlay": { "$ref": "#/$defs/openObject" },
        "icons": { "$ref": "#/$defs/openObject" },
        "layout": { "$ref": "#/$defs/openObject" },
        "presentationState": { "$ref": "#/$defs/openObject" },
        "metadata": { "$ref": "#/$defs/openObject" }
      }
    },
    "extensionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerPackageId", "schemaId", "version", "data"],
      "properties": {
        "ownerPackageId": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "data": { "$ref": "#/$defs/openObject" },
        "validationState": { "$ref": "#/$defs/openObject" }
      }
    }
  }
}
