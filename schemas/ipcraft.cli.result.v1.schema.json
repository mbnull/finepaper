{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.cli.result.v1",
  "title": "Ipcraft CLI Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schema", "diagnostics"],
  "allOf": [
    {
      "if": {
        "properties": { "ok": { "const": true } },
        "required": ["ok"]
      },
      "then": { "required": ["result"] }
    },
    {
      "if": {
        "properties": { "ok": { "const": false } },
        "required": ["ok"]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "properties": {
              "records": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "schema": { "const": "ipcraft.cli.result.v1" },
    "result": {
      "description": "Command-specific result payload.",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "$defs": {
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "records"],
      "properties": {
        "schema": { "const": "ipcraft.diagnostics.v1" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "source", "rule_id", "message", "locations"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "source": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": { "$ref": "#/$defs/details" },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "interface_id": { "type": "string", "minLength": 1 },
        "connection_id": { "type": "string", "minLength": 1 },
        "parameter_id": { "type": "string", "minLength": 1 },
        "table_id": { "type": "string", "minLength": 1 },
        "row": { "type": "integer", "minimum": 0 },
        "column": {
          "description": "Table or document column identifier.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "document_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column_number": { "type": "integer", "minimum": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "graph_object_id": { "type": "string", "minLength": 1 },
        "details": { "$ref": "#/$defs/details" }
      }
    },
    "details": {
      "description": "Rule-owned or location-kind-owned structured payload.",
      "type": "object",
      "additionalProperties": true
    }
  }
}
