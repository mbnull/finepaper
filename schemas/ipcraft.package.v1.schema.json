{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipcraft.package.v1",
  "title": "Ipcraft Package V1",
  "description": "Strict top-level package runtime schema. Unknown top-level fields are rejected; forward-compatible data belongs under metadata, native, native_schema, package-declared objects, or extension-owned payloads. Optional capability sections are extension-gated; missing declarations produce package.extension_required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name"],
  "allOf": [
    {
      "$comment": "config_schema.parameters is extension-gated by ipcraft.config.params; missing declaration produces package.extension_required.",
      "if": {
        "properties": {
          "config_schema": { "required": ["parameters"] }
        },
        "required": ["config_schema"]
      },
      "then": { "$ref": "#/$defs/requires_config_params_extension" }
    },
    {
      "$comment": "config_schema.tables is extension-gated by ipcraft.config.tables; missing declaration produces package.extension_required.",
      "if": {
        "properties": {
          "config_schema": { "required": ["tables"] }
        },
        "required": ["config_schema"]
      },
      "then": { "$ref": "#/$defs/requires_config_tables_extension" }
    },
    {
      "$comment": "config_schema.documents is extension-gated by ipcraft.config.documents; missing declaration produces package.extension_required.",
      "if": {
        "properties": {
          "config_schema": { "required": ["documents"] }
        },
        "required": ["config_schema"]
      },
      "then": { "$ref": "#/$defs/requires_config_documents_extension" }
    },
    {
      "$comment": "config_schema.files is extension-gated by ipcraft.config.files; missing declaration produces package.extension_required.",
      "if": {
        "properties": {
          "config_schema": { "required": ["files"] }
        },
        "required": ["config_schema"]
      },
      "then": { "$ref": "#/$defs/requires_config_files_extension" }
    },
    {
      "$comment": "interfaces is extension-gated by ipcraft.interfaces; missing declaration produces package.extension_required.",
      "if": { "required": ["interfaces"] },
      "then": { "$ref": "#/$defs/requires_interfaces_extension" }
    },
    {
      "$comment": "connection_rules is extension-gated by ipcraft.composition; missing declaration produces package.extension_required.",
      "if": { "required": ["connection_rules"] },
      "then": { "$ref": "#/$defs/requires_composition_extension" }
    },
    {
      "$comment": "emitters is extension-gated by ipcraft.emitters; missing declaration produces package.extension_required.",
      "if": { "required": ["emitters"] },
      "then": { "$ref": "#/$defs/requires_emitters_extension" }
    },
    {
      "$comment": "flows is extension-gated by ipcraft.flows; missing declaration produces package.extension_required.",
      "if": { "required": ["flows"] },
      "then": { "$ref": "#/$defs/requires_flows_extension" }
    },
    {
      "$comment": "artifacts is extension-gated by ipcraft.artifacts; missing declaration produces package.extension_required.",
      "if": { "required": ["artifacts"] },
      "then": { "$ref": "#/$defs/requires_artifacts_extension" }
    },
    {
      "$comment": "diagnostics is extension-gated by ipcraft.diagnostics; missing declaration produces package.extension_required.",
      "if": { "required": ["diagnostics"] },
      "then": { "$ref": "#/$defs/requires_diagnostics_extension" }
    },
    {
      "$comment": "views is extension-gated by ipcraft.views; missing declaration produces package.extension_required.",
      "if": { "required": ["views"] },
      "then": { "$ref": "#/$defs/requires_views_extension" }
    },
    {
      "$comment": "graph_config is extension-gated by ipcraft.graph_config; missing declaration produces package.extension_required.",
      "if": { "required": ["graph_config"] },
      "then": { "$ref": "#/$defs/requires_graph_config_extension" }
    }
  ],
  "properties": {
    "schema": { "const": "ipcraft.package.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "display": {
      "description": "Package-owned display metadata.",
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "description": "Declared extension IDs or extension-owned namespaces.",
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/extension_decl" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/extension_payload" }
        }
      ]
    },
    "config_schema": {
      "description": "Extension-gated package configuration schema. parameters, tables, documents, and files require their matching ipcraft.config.* extension or package.extension_required is emitted.",
      "$ref": "#/$defs/config_schema"
    },
    "interfaces": {
      "description": "Extension-gated interface declarations requiring ipcraft.interfaces.",
      "type": "array",
      "items": { "$ref": "#/$defs/interface" }
    },
    "connection_rules": {
      "description": "Extension-gated shallow composition rules requiring ipcraft.composition.",
      "$ref": "#/$defs/connection_rules"
    },
    "emitters": {
      "description": "Extension-gated input emitters requiring ipcraft.emitters.",
      "type": "array",
      "items": { "$ref": "#/$defs/emitter" }
    },
    "flows": {
      "description": "Extension-gated flow declarations requiring ipcraft.flows.",
      "type": "array",
      "items": { "$ref": "#/$defs/flow" }
    },
    "artifacts": {
      "description": "Extension-gated artifact declarations requiring ipcraft.artifacts.",
      "type": "array",
      "items": { "$ref": "#/$defs/package_object" }
    },
    "diagnostics": {
      "description": "Package-owned external diagnostic mapping rules.",
      "type": "object",
      "additionalProperties": true
    },
    "views": {
      "description": "Extension-gated view declarations requiring ipcraft.views.",
      "type": "array",
      "items": { "$ref": "#/$defs/package_object" }
    },
    "graph_config": {
      "description": "Package-declared graph configuration contract.",
      "$ref": "#/$defs/graph_config"
    },
    "plugin": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/package_object" }
      ]
    },
    "native_schema": {
      "description": "Schema for package-owned native payloads.",
      "type": "object",
      "additionalProperties": true
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "native": { "$ref": "#/$defs/native" }
  },
  "$defs": {
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/package_object" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/package_object" }
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/package_object" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/package_object" }
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "fanout": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "connection_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "kind_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "compatibility": {
          "type": "array",
          "items": { "$ref": "#/$defs/compatibility_rule" }
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "compatibility_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_type", "from", "to", "arity"],
      "properties": {
        "connection_type": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/endpoint_match" },
        "to": { "$ref": "#/$defs/endpoint_match" },
        "arity": { "type": "string", "enum": ["binary", "fanout"] },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "endpoint_match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 }
      }
    },
    "package_object": {
      "description": "Package-declared capability object.",
      "type": "object",
      "additionalProperties": true
    },
    "emitter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "emit_parameters",
            "emit_config_document",
            "emit_table",
            "copy_file",
            "emit_composition",
            "emit_graph_config"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "document": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "scope": {
          "type": "string",
          "enum": ["instance", "project"],
          "default": "instance",
          "description": "Omitted scope is normalized to instance."
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow_step" }
        },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "flow_step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "emit_inputs",
            "exec",
            "parse_diagnostics",
            "collect_artifacts",
            "plugin_hook"
          ]
        },
        "command": { "type": "object", "additionalProperties": true },
        "metadata": { "$ref": "#/$defs/metadata" },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "graph_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "objects", "relationships"],
      "properties": {
        "schema": { "const": "ipcraft.graph-config.v1" },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/graph_config_object" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/graph_config_relationship" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "native": { "$ref": "#/$defs/native" }
      }
    },
    "graph_config_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "graph_config_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "endpoints"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/graph_config_endpoint" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "graph_config_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "role"],
      "properties": {
        "object": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "extension_decl": {
      "oneOf": [
        { "$ref": "#/$defs/extension_id" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/extension_id" },
            "version": { "type": "string" },
            "required": { "type": "boolean" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "native": { "$ref": "#/$defs/native" }
          }
        }
      ]
    },
    "extension_id": {
      "type": "string",
      "minLength": 1
    },
    "known_extension_id": {
      "enum": [
        "ipcraft.config.params",
        "ipcraft.config.tables",
        "ipcraft.config.documents",
        "ipcraft.config.files",
        "ipcraft.interfaces",
        "ipcraft.composition",
        "ipcraft.layout",
        "ipcraft.emitters",
        "ipcraft.flows",
        "ipcraft.artifacts",
        "ipcraft.diagnostics",
        "ipcraft.views",
        "ipcraft.graph_config",
        "noc.v1"
      ]
    },
    "extension_payload": {
      "description": "Extension-owned namespace.",
      "type": "object",
      "additionalProperties": true
    },
    "requires_config_params_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_config_params_extension" }
      },
      "required": ["extensions"]
    },
    "requires_config_tables_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_config_tables_extension" }
      },
      "required": ["extensions"]
    },
    "requires_config_documents_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_config_documents_extension" }
      },
      "required": ["extensions"]
    },
    "requires_config_files_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_config_files_extension" }
      },
      "required": ["extensions"]
    },
    "requires_interfaces_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_interfaces_extension" }
      },
      "required": ["extensions"]
    },
    "requires_composition_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_composition_extension" }
      },
      "required": ["extensions"]
    },
    "requires_emitters_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_emitters_extension" }
      },
      "required": ["extensions"]
    },
    "requires_flows_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_flows_extension" }
      },
      "required": ["extensions"]
    },
    "requires_artifacts_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_artifacts_extension" }
      },
      "required": ["extensions"]
    },
    "requires_diagnostics_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_diagnostics_extension" }
      },
      "required": ["extensions"]
    },
    "requires_views_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_views_extension" }
      },
      "required": ["extensions"]
    },
    "requires_graph_config_extension": {
      "properties": {
        "extensions": { "$ref": "#/$defs/has_graph_config_extension" }
      },
      "required": ["extensions"]
    },
    "has_config_params_extension": { "$ref": "#/$defs/has_ipcraft.config.params" },
    "has_config_tables_extension": { "$ref": "#/$defs/has_ipcraft.config.tables" },
    "has_config_documents_extension": { "$ref": "#/$defs/has_ipcraft.config.documents" },
    "has_config_files_extension": { "$ref": "#/$defs/has_ipcraft.config.files" },
    "has_interfaces_extension": { "$ref": "#/$defs/has_ipcraft.interfaces" },
    "has_composition_extension": { "$ref": "#/$defs/has_ipcraft.composition" },
    "has_emitters_extension": { "$ref": "#/$defs/has_ipcraft.emitters" },
    "has_flows_extension": { "$ref": "#/$defs/has_ipcraft.flows" },
    "has_artifacts_extension": { "$ref": "#/$defs/has_ipcraft.artifacts" },
    "has_diagnostics_extension": { "$ref": "#/$defs/has_ipcraft.diagnostics" },
    "has_views_extension": { "$ref": "#/$defs/has_ipcraft.views" },
    "has_graph_config_extension": { "$ref": "#/$defs/has_ipcraft.graph_config" },
    "has_ipcraft.config.params": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.config.params" }
    },
    "has_ipcraft.config.tables": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.config.tables" }
    },
    "has_ipcraft.config.documents": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.config.documents" }
    },
    "has_ipcraft.config.files": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.config.files" }
    },
    "has_ipcraft.interfaces": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.interfaces" }
    },
    "has_ipcraft.composition": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.composition" }
    },
    "has_ipcraft.emitters": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.emitters" }
    },
    "has_ipcraft.flows": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.flows" }
    },
    "has_ipcraft.artifacts": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.artifacts" }
    },
    "has_ipcraft.diagnostics": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.diagnostics" }
    },
    "has_ipcraft.views": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.views" }
    },
    "has_ipcraft.graph_config": {
      "type": "array",
      "contains": { "$ref": "#/$defs/ext_ipcraft.graph_config" }
    },
    "ext_ipcraft.config.params": {
      "oneOf": [{ "const": "ipcraft.config.params" }, { "$ref": "#/$defs/ext_obj_ipcraft.config.params" }]
    },
    "ext_ipcraft.config.tables": {
      "oneOf": [{ "const": "ipcraft.config.tables" }, { "$ref": "#/$defs/ext_obj_ipcraft.config.tables" }]
    },
    "ext_ipcraft.config.documents": {
      "oneOf": [{ "const": "ipcraft.config.documents" }, { "$ref": "#/$defs/ext_obj_ipcraft.config.documents" }]
    },
    "ext_ipcraft.config.files": {
      "oneOf": [{ "const": "ipcraft.config.files" }, { "$ref": "#/$defs/ext_obj_ipcraft.config.files" }]
    },
    "ext_ipcraft.interfaces": {
      "oneOf": [{ "const": "ipcraft.interfaces" }, { "$ref": "#/$defs/ext_obj_ipcraft.interfaces" }]
    },
    "ext_ipcraft.composition": {
      "oneOf": [{ "const": "ipcraft.composition" }, { "$ref": "#/$defs/ext_obj_ipcraft.composition" }]
    },
    "ext_ipcraft.emitters": {
      "oneOf": [{ "const": "ipcraft.emitters" }, { "$ref": "#/$defs/ext_obj_ipcraft.emitters" }]
    },
    "ext_ipcraft.flows": {
      "oneOf": [{ "const": "ipcraft.flows" }, { "$ref": "#/$defs/ext_obj_ipcraft.flows" }]
    },
    "ext_ipcraft.artifacts": {
      "oneOf": [{ "const": "ipcraft.artifacts" }, { "$ref": "#/$defs/ext_obj_ipcraft.artifacts" }]
    },
    "ext_ipcraft.diagnostics": {
      "oneOf": [{ "const": "ipcraft.diagnostics" }, { "$ref": "#/$defs/ext_obj_ipcraft.diagnostics" }]
    },
    "ext_ipcraft.views": {
      "oneOf": [{ "const": "ipcraft.views" }, { "$ref": "#/$defs/ext_obj_ipcraft.views" }]
    },
    "ext_ipcraft.graph_config": {
      "oneOf": [{ "const": "ipcraft.graph_config" }, { "$ref": "#/$defs/ext_obj_ipcraft.graph_config" }]
    },
    "ext_obj_ipcraft.config.params": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.config.params" } }
    },
    "ext_obj_ipcraft.config.tables": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.config.tables" } }
    },
    "ext_obj_ipcraft.config.documents": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.config.documents" } }
    },
    "ext_obj_ipcraft.config.files": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.config.files" } }
    },
    "ext_obj_ipcraft.interfaces": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.interfaces" } }
    },
    "ext_obj_ipcraft.composition": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.composition" } }
    },
    "ext_obj_ipcraft.emitters": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.emitters" } }
    },
    "ext_obj_ipcraft.flows": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.flows" } }
    },
    "ext_obj_ipcraft.artifacts": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.artifacts" } }
    },
    "ext_obj_ipcraft.diagnostics": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.diagnostics" } }
    },
    "ext_obj_ipcraft.views": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.views" } }
    },
    "ext_obj_ipcraft.graph_config": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "const": "ipcraft.graph_config" } }
    },
    "metadata": {
      "description": "Application-owned metadata namespace.",
      "type": "object",
      "additionalProperties": true
    },
    "native": {
      "description": "Native tool payload preserved by Ipcraft.",
      "type": "object",
      "additionalProperties": true
    }
  }
}
