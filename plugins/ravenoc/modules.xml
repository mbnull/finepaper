<?xml version="1.0" encoding="UTF-8"?>
<module-bundle>
  <module name="RaveTile" palette_label="Rave Tile" graph_group="xps" description="Editable RaveNoC router tile backed by upstream RTL mesh.">
    <identity external_id_prefix="rave" display_prefix="Rave" width="2" supports_mesh_coordinates="true" />
    <interfaces>
      <interface id="north" label="North" bus="ravenoc_router_link" role="target" connects_to="initiator" match="">
      </interface>
      <interface id="east" label="East" bus="ravenoc_router_link" role="initiator" connects_to="target" match="">
      </interface>
      <interface id="south" label="South" bus="ravenoc_router_link" role="initiator" connects_to="target" match="">
      </interface>
      <interface id="west" label="West" bus="ravenoc_router_link" role="target" connects_to="initiator" match="">
      </interface>
      <interface id="local" label="Local" bus="ravenoc_endpoint_link" role="target" connects_to="initiator" match="">
      </interface>
    </interfaces>
    <ports>
      <port id="north" direction="inout" type="bus" bus_type="ravenoc_router_link" role="router" name="North" description="North RaveNoC router link" interface="north" />
      <port id="east" direction="inout" type="bus" bus_type="ravenoc_router_link" role="router" name="East" description="East RaveNoC router link" interface="east" />
      <port id="south" direction="inout" type="bus" bus_type="ravenoc_router_link" role="router" name="South" description="South RaveNoC router link" interface="south" />
      <port id="west" direction="inout" type="bus" bus_type="ravenoc_router_link" role="router" name="West" description="West RaveNoC router link" interface="west" />
      <port id="local" direction="input" type="bus" bus_type="ravenoc_endpoint_link" role="attachment" name="Local" description="Local RaveNoC endpoint slot" interface="local" />
    </ports>
    <parameters>
      <parameter name="display_name" type="string" default="Rave Tile" label="Display name" description="Name shown on the canvas." />
      <parameter name="external_id" type="string" default="rave_00" label="External ID" description="Stable generated artifact identifier." />
      <parameter name="x" type="int" default="0" description="Canvas X position." configurable="false" />
      <parameter name="y" type="int" default="0" description="Canvas Y position." configurable="false" />
      <parameter name="mesh_col" type="int" default="0" description="Logical RaveNoC mesh column." configurable="false" />
      <parameter name="mesh_row" type="int" default="0" description="Logical RaveNoC mesh row." configurable="false" />
      <parameter name="flit_data_width" type="int" default="32" label="Flit data width" description="FLIT_DATA_WIDTH macro value." min="8" max="512" />
      <parameter name="flit_type_width" type="int" default="2" label="Flit type width" description="FLIT_TP_WIDTH macro value." min="1" max="8" />
      <parameter name="flit_buffer_depth" type="int" default="2" label="Flit buffer depth" description="FLIT_BUFF macro value; must be a power of two." min="1" max="1024" />
      <parameter name="virtual_channels" type="int" default="3" label="Virtual channels" description="N_VIRT_CHN macro value." min="1" max="16" />
      <parameter name="routing_algorithm" type="string" default="xy" label="Routing algorithm" description="ROUTING_ALG macro value.">
        <choices>
          <choice value="xy" label="XY" />
          <choice value="yx" label="YX" />
        </choices>
      </parameter>
      <parameter name="priority" type="string" default="zero_high" label="Priority" description="H_PRIORITY macro value.">
        <choices>
          <choice value="zero_high" label="Zero High" />
          <choice value="zero_low" label="Zero Low" />
        </choices>
      </parameter>
      <parameter name="max_packet_flits" type="int" default="256" label="Max packet flits" description="MAX_SZ_PKT macro value." min="1" max="4096" />
      <parameter name="axi_addr_width" type="int" default="32" label="AXI address width" description="AXI_ADDR_WIDTH macro value." min="8" max="64" />
      <parameter name="axi_data_width" type="int" default="32" label="AXI data width" description="AXI_DATA_WIDTH macro value." min="8" max="512" />
      <parameter name="axi_cdc_required" type="string" default="all" label="AXI CDC required" description="AXI_CDC_REQ policy: all, none, or bit mask." />
      <parameter name="bypass_cdc" type="bool" default="false" label="Bypass CDC in smoke" description="Drive generated bypass_cdc vector high in the smoke wrapper." />
    </parameters>
  </module>
  <module name="RaveEndpoint" palette_label="Rave Endpoint" graph_group="endpoints" description="Editable RaveNoC endpoint attachment for a router tile.">
    <identity external_id_prefix="rave_ep" display_prefix="Rave EP" width="2" supports_mesh_coordinates="false" />
    <interfaces>
      <interface id="noc" label="NoC" bus="ravenoc_endpoint_link" role="initiator" connects_to="target" match="">
      </interface>
    </interfaces>
    <ports>
      <port id="noc" direction="output" type="bus" bus_type="ravenoc_endpoint_link" role="attachment" name="NoC" description="RaveNoC endpoint attachment" interface="noc" />
    </ports>
    <parameters>
      <parameter name="display_name" type="string" default="Rave Endpoint" label="Display name" description="Name shown on the canvas." />
      <parameter name="external_id" type="string" default="rave_ep_00" label="External ID" description="Stable generated artifact identifier." />
      <parameter name="x" type="int" default="0" description="Canvas X position." configurable="false" />
      <parameter name="y" type="int" default="0" description="Canvas Y position." configurable="false" />
    </parameters>
  </module>
</module-bundle>
